appname                    = mister-downloader
version                    = 1.0.3
display_name               = Mister 下载器
desc                       = 为飞牛 fnOS 打包的原生下载器，内置 Mister Download Manager 0.5.2 无界面引擎：多连接高速下载、断点续传、分类目录、队列与种子下载。应用带中文登录门禁（未登录完全隐藏内容）、管理员/运维员分级、下载目录设置与 Gitee 更新检测。仅支持 x86 设备，无需 Docker。
source                     = thirdparty
platform                   = x86

maintainer                 = wenming758
maintainer_url             = https://github.com/wenming758
distributor                = wenming758
distributor_url            = https://gitee.com/wenming760

os_min_version             = 1.1.3100

desktop_uidir              = ui
desktop_applaunchname      = mister-downloader.main

ctl_stop                   = true
checkport                  = false
disable_authorization_path = true

changelog                  = 1.0.3：下载界面改为应用原生实现，不再依赖内嵌原版页面，修复“MDM 没有响应”导致完全不可用的问题；新增添加/暂停/继续/移除/删除文件与实时进度，原版面板仍可一键切换；应用改为 root 运行，可直接下载到 /vol2/1000 等共享文件夹；新增面板请求日志便于排查。
